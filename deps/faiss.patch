+    IndexMultiPQ::IndexMultiPQ(int d, size_t M, size_t nbits_low, size_t nbits_high, float threshold, MetricType metric) : Index(d, metric), mpq(d, M, nbits_low, nbits_high), threshold(threshold)
+    {
+    }
+
+    void IndexMultiPQ::train(idx_t n, const float *x)
+    {
+        mpq.train_low(n, x);
+    }
+
+    void IndexMultiPQ::train_high_precision(idx_t n, const float *x)
+    {
+        mpq.train_high(n, x);
+    }
+
+    void IndexMultiPQ::add_priors(idx_t n, std::vector<float> x)
+    {
+        priors = x;
+        high_indexes.clear();
+        high_precision_lookup.clear();
+        idx_t cnt = 0;
+
+        for (int i = 0; i < x.size(); i++)
+        {
+            if (x[i] > threshold)
+            {
+                high_indexes.push_back(i);
+                high_precision_lookup.insert(std::pair<idx_t, idx_t>(i, cnt));
+                cnt++;
+            }
+        }
+    }
+
+    void IndexMultiPQ::add(idx_t n, const float *x)
+    {
+        codes_low.resize(n * mpq.code_size_low);
+        mpq.compute_codes_low(x, &codes_low[0], n);
+
+        codes_high.resize(high_indexes.size() * mpq.code_size_high);
+        float *x_high = new float[high_indexes.size() * mpq.d];
+        for (int i = 0; i < high_indexes.size(); i++)
+        {
+            for (int j = 0; j < mpq.d; j++)
+            {
+                x_high[i * mpq.d + j] = x[high_indexes[i] * mpq.d + j];
+            }
+        }
+        mpq.compute_codes_high(x_high, &codes_high[0], high_indexes.size());
+        delete x_high;
+        ntotal = n;
+    }
+
+    void IndexMultiPQ::reset()
+    {
+        codes_low.clear();
+        codes_high.clear();
+        priors.clear();
+        high_precision_lookup.clear();
+        high_indexes.clear();
+    }
+
+    void IndexMultiPQ::reconstruct_n(idx_t i0, idx_t ni, float *recons) const
+    {
+        for (idx_t i = 0; i < ni; i++)
+        {
+            reconstruct(i0 + i, recons + i * mpq.d);
+        }
+    }
+
+    void IndexMultiPQ::reconstruct(idx_t key, float *recons) const
+    {
+        FAISS_THROW_IF_NOT(key >= 0);
+        auto search = high_precision_lookup.find(key);
+        if (search != high_precision_lookup.end())
+        {
+            mpq.decode_high(codes_high.data() + (search->second * mpq.code_size_high), recons);
+        }
+        else
+        {
+            mpq.decode_low(codes_low.data() + key*mpq.code_size_low, recons);
+        }
+    }
+
+    float IndexMultiPQ::sdc_lookup (idx_t i, idx_t j) 
+    {
+        auto high1_lkup = high_precision_lookup.find(i);
+        auto high2_lkup = high_precision_lookup.find(j);
+        bool high1_p = (high1_lkup != high_precision_lookup.end());
+        bool high2_p = (high2_lkup != high_precision_lookup.end());
+        const uint8_t* code1 = high1_p ?  (codes_high.data() + (high1_lkup->second * mpq.code_size_high)): (codes_low.data() + (i*mpq.code_size_low));
+        const uint8_t* code2 = high2_p ?  (codes_high.data() + (high2_lkup->second * mpq.code_size_high)): (codes_low.data() + (j*mpq.code_size_low));
+
+        return mpq.sdc_lookup(code1, high1_p, code2, high2_p);
+    }
+
+    float IndexMultiPQ::dis_lookup (const float* table, idx_t i)
+    {
+        auto high_lkup = high_precision_lookup.find(i);
+        if (high_lkup == high_precision_lookup.end()) {
+            return mpq.dis_lookup(table, codes_low.data() + (i*mpq.code_size_low), false);
+        } else {
+            return mpq.dis_lookup(table, codes_high.data() + (high_lkup->second*mpq.code_size_high), true);
+        }
+    }
+
+    void IndexMultiPQ::search(
+        idx_t n,
+        const float *x,
+        idx_t k,
+        float *distances,
+        idx_t *labels) const
+    {
+        float_maxheap_array_t res = {
+                    size_t(n), size_t(k), labels, distances};
+        mpq.search(x, n, codes_low.data(), codes_high.data(), codes_low.size() / mpq.code_size_low, codes_high.size() / mpq.code_size_high, high_precision_lookup, high_indexes, &res, true);
+    }
 
