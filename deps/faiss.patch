+      if (verbose)
+      {
+        clus.verbose = true;
+        printf("Training MultiPQ low slice %d/%zd\n", m, M);
+      }
+      */
+      IndexFlatL2 index(dsub);
+      //clus.train(n, xslice, assign_index ? *assign_index : index);
+      clus.train(n, xslice, index);
+      set_params_high(clus.centroids.data(), m);
+    }
+  }
